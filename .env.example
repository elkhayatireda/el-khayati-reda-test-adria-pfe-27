# ========================================================
# Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.
# Note: .env is ignored by Git for security.
# ========================================================

# OpenAI / Groq API Key
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# OpenAI base URL (Default: https://api.openai.com/v1 | Groq: https://api.groq.com/openai/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Model (e.g. gpt-4o, gpt-4o-mini | Groq: qwen/qwen3.8-27b, llama-3.3-70b-versatile)
OPENAI_MODEL=gpt-4o

# Discord Bot Token (Obtained from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here
